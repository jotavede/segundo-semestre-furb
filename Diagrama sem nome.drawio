        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Viagem {\n        - distancia : double\n        - quantidadePassageiros : int\n        + Viagem(distancia: double, quantidadePassageiros: int)\n        + calcularCusto()* double\n        + getDistancia() double\n        + getQuantidadePassageiros() int\n    }\n\n    class ViagemCarro {\n        + ViagemCarro(distancia: double, quantidadePassageiros: int)\n        + calcularCusto() double\n    }\n\n    class ViagemOnibus {\n        + ViagemOnibus(distancia: double, quantidadePassageiros: int)\n        + calcularCusto() double\n    }\n\n    class ViagemAviao {\n        + ViagemAviao(distancia: double, quantidadePassageiros: int)\n        + calcularCusto() double\n    }\n\n    class ViagemTest {\n        + testCalcularCustoViagemCarro() void\n        + testCalcularCustoViagemOnibus() void\n        + testCalcularCustoViagemAviao() void\n    }\n\n    Viagem &lt;|-- ViagemCarro\n    Viagem &lt;|-- ViagemOnibus\n    Viagem &lt;|-- ViagemAviao\n    ViagemTest ..&gt; ViagemCarro : &lt;&lt;use&gt;&gt;\n    ViagemTest ..&gt; ViagemOnibus : &lt;&lt;use&gt;&gt;\n    ViagemTest ..&gt; ViagemAviao : &lt;&lt;use&gt;&gt;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7deJ58MxpO8yc1dFC25j-1">
